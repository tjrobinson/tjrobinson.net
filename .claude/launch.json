{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "quartz",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["quartz", "build", "--serve"],
      "port": 8080
    },
    {
      "name": "landing",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cp index.html public/index.html && npx serve public -l 3000 --no-request-logging"
      ],
      "port": 3000
    }
  ]
}
